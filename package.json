{
  "name": "pg-react-auth",
  "version": "1.0.0",
  "description": "Lightweight Node + React + PostgreSQL Authentication App",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm.cmd --prefix client run dev",
    "dev": "concurrently \"npm.cmd run server\" \"npm.cmd run client\"",
    "db:init": "node server/db.js"
  },
  "keywords": ["react", "node", "postgresql", "tailwind", "auth"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
